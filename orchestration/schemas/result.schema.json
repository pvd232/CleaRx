{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clearx.local/schemas/result.schema.json",
  "title": "CleaRx packet result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packet_id", "packet_sha256", "git_commit", "run_id", "environment", "commands", "artifacts", "required_checks", "outcome", "deviations", "started_at", "finished_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "packet_id": {"type": "string"},
    "packet_sha256": {"$ref": "#/$defs/sha256"},
    "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "environment": {"type": "object", "required": ["kind"], "properties": {"kind": {"enum": ["local_m1", "a100", "l4", "mixed"]}}, "additionalProperties": true},
    "commands": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["command", "exit_code"], "properties": {"command": {"type": "string"}, "exit_code": {"type": "integer"}, "stdout_path": {"$ref": "#/$defs/repo_path"}, "stderr_path": {"$ref": "#/$defs/repo_path"}}}},
    "artifacts": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "size_bytes"], "properties": {"path": {"$ref": "#/$defs/repo_path"}, "sha256": {"$ref": "#/$defs/sha256"}, "size_bytes": {"type": "integer", "minimum": 0}}}},
    "required_checks": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "outcome": {"enum": ["complete", "failed", "blocked", "cancelled"]},
    "deviations": {"type": "array", "items": {"type": "string"}},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repo_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"}
  }
}
