{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clearx.local/schemas/fixture_index.schema.json",
  "title": "CleaRx generated reference fixture index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "index_id", "generator_commit", "fixtures"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "index_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "generator_commit": {"$ref": "#/$defs/commit"},
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["boundary_id", "case_id", "manifest_path", "manifest_sha256"],
        "properties": {
          "boundary_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
          "case_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
          "manifest_path": {"$ref": "#/$defs/repo_path"},
          "manifest_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "repo_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"}
  }
}
