{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clearx.local/schemas/benchmark.schema.json",
  "title": "CleaRx benchmark contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "benchmark_id", "host_profile", "workload", "metrics", "repetitions", "warmups"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "benchmark_id": {"type": "string", "minLength": 1},
    "host_profile": {"type": "string", "minLength": 1},
    "workload": {"type": "object", "minProperties": 1},
    "metrics": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "repetitions": {"type": "integer", "minimum": 1},
    "warmups": {"type": "integer", "minimum": 0},
    "thresholds": {"type": "object"},
    "paired_keys": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
  }
}
