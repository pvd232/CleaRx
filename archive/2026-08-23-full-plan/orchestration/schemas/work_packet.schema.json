{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clearx.local/schemas/work_packet.schema.json",
  "title": "CleaRx immutable work packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "phase", "objective", "depends_on", "execution", "inputs", "outputs", "acceptance", "forbidden", "non_goals", "escalation", "evidence"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "id": {"type": "string", "pattern": "^(BOOTSTRAP-[0-9]{3}|P[0-9]+-[0-9]{3}[A-Z]?)$"},
    "title": {"type": "string", "minLength": 1},
    "phase": {"oneOf": [{"type": "integer", "minimum": 0}, {"const": "bootstrap"}]},
    "objective": {"type": "string", "minLength": 1},
    "rationale": {"type": "string"},
    "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment", "write_scope"],
      "properties": {
        "environment": {"enum": ["local_m1", "a100", "l4", "mixed"]},
        "write_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/repo_path"}}
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {"path": {"$ref": "#/$defs/repo_path"}, "sha256": {"$ref": "#/$defs/sha256"}}
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "producer_packet"],
            "properties": {"path": {"$ref": "#/$defs/repo_path"}, "producer_packet": {"type": "string"}}
          }
        ]
      }
    },
    "outputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/repo_path"}},
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands", "required_checks"],
      "properties": {
        "commands": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "required_checks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "tolerances": {"type": "object"},
        "measurements": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "forbidden": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "non_goals": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "escalation": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result_schema", "result_path_template"],
      "properties": {
        "result_schema": {"$ref": "#/$defs/repo_path"},
        "result_path_template": {"type": "string", "pattern": "^runs/[A-Za-z0-9-]+/\\{run_id\\}/result\\.json$"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repo_path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"}
  }
}
